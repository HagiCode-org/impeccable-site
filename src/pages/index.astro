---
import { SUPPORTED_SITE_LOCALES } from '@/i18n/locale-metadata';
import { getAbsoluteSiteUrl } from '@/lib/i18n/locale-routing';
import '@/styles/global.css';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Impeccable Commands</title>
    <meta http-equiv="refresh" content="0; url=/docs/" />
    <link rel="canonical" href="https://impeccable.hagicode.com/docs/" />
    {
      SUPPORTED_SITE_LOCALES.map((locale) => (
        <link rel="alternate" hreflang={locale} href={getAbsoluteSiteUrl('/docs/', locale, 'https://impeccable.hagicode.com')} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href="https://impeccable.hagicode.com/docs/" />
  </head>
  <body class="landing-page">
    <main class="landing-card">
      <p>Redirecting to the command overview…</p>
      <a href="/docs/">Continue to the docs</a>
    </main>

    <script>
      import { redirectRootEntryToPreferredLocale } from '@/scripts/entry-locale-routing';

      redirectRootEntryToPreferredLocale();
    </script>
  </body>
</html>
