---
import RootTransit from '@hagicode/hagilight-core/RootTransit';
import { SITE_LOCALES, SUPPORTED_SITE_LOCALES } from '@/i18n/locale-metadata';
import { getAbsoluteSiteUrl, getLocalizedPath } from '@/lib/i18n/locale-routing';

const siteUrl = Astro.site?.toString() ?? 'https://impeccable.hagicode.com';
const links = SITE_LOCALES.filter((locale) => locale.code !== 'en-US').map((locale) => ({
  destination: getLocalizedPath('/docs/', locale.code),
  label: locale.nativeName,
  lang: locale.code,
}));
---

<RootTransit
  destination={getLocalizedPath('/docs/', 'en-US')}
  siteName="Impeccable Commands"
  locale="en-US"
  links={links}
>
  {SUPPORTED_SITE_LOCALES.map((locale) => (
    <link slot="head" rel="alternate" hreflang={locale} href={getAbsoluteSiteUrl('/docs/', locale, siteUrl)} />
  ))}
  <link slot="head" rel="alternate" hreflang="x-default" href={getAbsoluteSiteUrl('/docs/', 'en-US', siteUrl)} />
</RootTransit>
