---
import { SUPPORTED_SITE_LOCALES, getSiteLocaleDefinition, resolveSiteLocale } from '@/i18n/locale-metadata';
import { getAbsoluteSiteUrl, getLocalizedPath } from '@/lib/i18n/locale-routing';
import { t } from '@/lib/i18n/ui';
import '@/styles/global.css';

export function getStaticPaths() {
  return SUPPORTED_SITE_LOCALES.filter((locale) => locale !== 'en-US').map((locale) => ({ params: { locale } }));
}

const locale = resolveSiteLocale(Astro.params.locale);
const localeDefinition = getSiteLocaleDefinition(locale);
const siteUrl = Astro.site?.toString() ?? 'https://impeccable.hagicode.com';
const canonicalUrl = getAbsoluteSiteUrl('/docs/', locale, siteUrl);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${t(locale, 'common', 'site.name')} · ${localeDefinition.nativeName}`}</title>
    <meta http-equiv="refresh" content={`0; url=${getLocalizedPath('/docs/', locale)}`} />
    <link rel="canonical" href={canonicalUrl} />
    {
      SUPPORTED_SITE_LOCALES.map((candidate) => (
        <link rel="alternate" hreflang={candidate} href={getAbsoluteSiteUrl('/docs/', candidate, siteUrl)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteSiteUrl('/docs/', 'en-US', siteUrl)} />
  </head>
  <body class="landing-page">
    <main class="landing-card">
      <p>{t(locale, 'common', 'entry.redirecting')}</p>
      <a href={getLocalizedPath('/docs/', locale)}>{t(locale, 'common', 'entry.continue')}</a>
    </main>
  </body>
</html>
