---
import { SUPPORTED_SITE_LOCALES, type SiteLocale } from '@/i18n/locale-metadata';
import { getLocalizedPath } from '@/lib/i18n/locale-routing';
import { t } from '@/lib/i18n/ui';

interface Props {
  locale: SiteLocale;
  routeKey: string;
  alternateLocalePaths?: Partial<Record<SiteLocale, string>>;
}

const { locale, routeKey, alternateLocalePaths } = Astro.props;
---

<nav class="language-switcher" aria-label={t(locale, 'common', 'language.label')}>
  {
    SUPPORTED_SITE_LOCALES.map((candidate) => (
      <a
        href={alternateLocalePaths?.[candidate] ?? getLocalizedPath(routeKey, candidate)}
        class:list={['language-switcher__item', { 'is-active': candidate === locale }]}
        hreflang={candidate}
        lang={candidate}
      >
        {t(locale, 'common', `language.${candidate}`)}
      </a>
    ))
  }
</nav>
