---
import type { SiteLocale } from '@/i18n/locale-metadata';
import { t } from '@/lib/i18n/ui';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const href = 'https://hagicode.com/';
---

<section class="docs-promote" data-docs-promote hidden aria-label={t(locale, 'common', 'promote.ariaLabel')}>
  <div class="docs-promote__shell">
    <button
      type="button"
      class="docs-promote__close"
      aria-label={t(locale, 'common', 'promote.closeLabel')}
      data-docs-promote-close
    >
      ×
    </button>

    <a class="docs-promote__surface" href={href} target="_blank" rel="noreferrer">
      <strong class="docs-promote__title">{t(locale, 'common', 'promote.title')}</strong>
      <span class="docs-promote__summary">{t(locale, 'common', 'promote.summary')}</span>
      <span class="docs-promote__cta">{t(locale, 'common', 'promote.cta')}</span>
    </a>
  </div>
</section>

<script>
  import { initDocsPromoteCard } from '@/scripts/docs-promote-card';

  initDocsPromoteCard();
</script>

<style>
  .docs-promote {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 24;
    width: min(23rem, calc(100vw - 1.5rem));
  }

  .docs-promote__shell {
    position: relative;
    border: 1px solid rgba(72, 46, 34, 0.18);
    border-radius: calc(var(--radius-xl) + 2px);
    background: rgba(255, 248, 239, 0.94);
    box-shadow: 0 18px 42px rgba(78, 42, 28, 0.14);
    backdrop-filter: blur(20px);
  }

  .docs-promote__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(72, 46, 34, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .docs-promote__surface {
    display: grid;
    gap: 0.55rem;
    padding: 1.1rem 1.1rem 1rem;
  }

  .docs-promote__title {
    max-width: 18ch;
    font-size: 1.08rem;
    line-height: 1.25;
    color: var(--text);
  }

  .docs-promote__summary {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .docs-promote__cta {
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 720px) {
    .docs-promote {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 0.75rem;
      width: auto;
    }
  }
</style>
