{
  "name": "impeccable-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run prepare && astro dev --host 0.0.0.0 --port ${PORT_IMPECCABLE_SITE:-31266}",
    "build": "export NODE_ENV=\"${NODE_ENV:-production}\"; npm run prepare && astro build",
    "preview": "astro preview --port ${PORT_IMPECCABLE_SITE:-31266}",
    "astro": "astro",
    "prepare": "npm run i18n:generate && npm run catalog:generate",
    "typecheck": "npm run prepare && astro check",
    "test": "npm run prepare && vitest run",
    "validate": "npm run i18n:check && npm run catalog:check && npm run typecheck && npm run test && npm run build",
    "i18n:audit": "hagi18n audit --config hagi18n.yaml",
    "i18n:report": "hagi18n report --config hagi18n.yaml",
    "i18n:doctor": "hagi18n doctor --config hagi18n.yaml",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml --from en-US",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --from en-US --write",
    "i18n:prune": "hagi18n prune --config hagi18n.yaml --from en-US",
    "i18n:prune:write": "hagi18n prune --config hagi18n.yaml --from en-US --write",
    "i18n:generate": "node scripts/generate-i18n-resources.mjs",
    "i18n:check": "npm run i18n:audit && npm run i18n:doctor && npm run i18n:generate && node scripts/generate-i18n-resources.mjs --check",
    "catalog:generate": "node scripts/build-command-catalog.mjs",
    "catalog:check": "npm run catalog:generate && node scripts/build-command-catalog.mjs --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^6.0.7",
    "astro-seo": "^1.1.0"
  },
  "devDependencies": {
    "@hagicode/hagi18n": "^0.1.1",
    "js-yaml": "^4.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.2"
  }
}
